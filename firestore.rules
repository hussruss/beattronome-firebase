rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isUserSessionOwner() {
      return request.auth != null && request.auth.uid == resource.data.authorId;
    }

    function isPublic() {
      return resource.data.isPublic == true;
    }

    match /stories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /posts/{document=**} { allow read: if true; allow write: if isAdmin(); }

    match /users/{uid} {
      allow read, write: if isAdmin() || isUser(uid);
    }

    match /users_bo/{uid} {
       allow read: if isAdmin() || isUser(uid);                                                                                                                                                                                    
      allow update: if isUser(uid)                                                                                                                                                                                                
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['fcmTokens', 'updatedAt', 'lastLoginAt', 'name', 'email', 'createdAt']);                                                                                                                       
      allow write: if isAdmin();      
    }

    match /rudiments/{document=**} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
                        && request.resource.data.downloadCount == resource.data.downloadCount + 1);
    }

    match /my_rudiments/{uid} {
      allow read, write: if isUser(uid);
    }

    match /patterns/{document=**} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
                        && request.resource.data.downloadCount == resource.data.downloadCount + 1);
    }

    match /my_patterns/{uid} {
      allow read, write: if isUser(uid);
    }

    match /grooves/{document=**} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
                        && request.resource.data.downloadCount == resource.data.downloadCount + 1);
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin()
                  || isPublic()
                  || isUserSessionOwner();

      allow create: if request.auth != null &&
                      request.resource.data.authorId == request.auth.uid;

      allow update: if request.auth != null &&
                      resource.data.authorId == request.auth.uid &&
                      request.resource.data.authorId == request.auth.uid;

      allow delete: if request.auth != null &&
                      resource.data.authorId == request.auth.uid;
    }

    // --- REGLAS PARA REVENUECAT ---
    // Nota: Por defecto la extensión usa la colección "customers".
    // Si en la configuración de la extensión le pusiste otro nombre
    // (ej. "suscripciones"), cambia la palabra "customers" abajo por ese nombre.
    match /customers/{uid} {
      allow read: if isAdmin() || isUser(uid);
    }

    // RevenueCat extension events — only the backoffice dashboard reads
    // them. (Was `isUser(uid)` with no `uid` in scope: always false.)
    match /customers_events/{id} {
      allow read: if isAdmin();
    }

    match /new_installations/{document} {
      allow create: if true;
      allow read: if isAdmin();
      allow delete: if isAdmin();

    }

    match /user_sessions/{document} {
      allow create: if true;
      allow read: if isAdmin();
      allow delete: if isAdmin();

    }

    match /activity_logs/{document} {
      allow create: if true;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // Practice metric: one doc per user per day, `{userKey}_{YYYY-MM-DD}`,
    // upserted with increments. userKey is the auth uid, or `anon:{installId}`
    // only when there is no auth session (shape-checked, like user_sessions).
    function isValidPracticeDay(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['user_key', 'date', 'auth_uid', 'anon_id',
                               'is_premium', 'seconds', 'runs',
                               'training_seconds', 'modes', 'content',
                               'app_version', 'platform', 'last_at'])
        && d.user_key is string
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && docId == d.user_key + '_' + d.date
        && d.seconds is int && d.seconds >= 0 && d.seconds <= 86400
        && d.runs is int
        && d.modes is map
        && (!('content' in d) || d.content is map)
        && (!('is_premium' in d) || d.is_premium is bool)
        && (request.auth != null
              ? d.user_key == request.auth.uid
              : d.user_key.matches('^anon:.+'));
    }

    match /practice_days/{docId} {
      allow create, update: if isValidPracticeDay(docId);
      allow read, delete: if isAdmin();
    }

    // Guest → existing account: the app asks the backoffice
    // `mergeGuestData` function to move the guest's data. Only the account
    // itself may ask, and only with the guest's ID token (checked by the
    // function, which also deletes it). No client updates or deletes.
    match /guest_merges/{mergeId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['account_uid', 'guest_uid',
                                                 'guest_id_token', 'status',
                                                 'created_at'])
        && request.resource.data.account_uid == request.auth.uid
        && request.resource.data.guest_uid is string
        && request.resource.data.guest_uid != request.auth.uid
        && request.resource.data.guest_id_token is string
        && request.resource.data.status == 'pending';
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.account_uid == request.auth.uid);
    }

    // Aggregates written by the backoffice (Admin SDK bypasses rules).
    match /practice_daily/{document} { allow read: if isAdmin(); }
    match /practice_weekly/{document} { allow read: if isAdmin(); }

    match /ad_revenue/{document} {
      allow read: if isAdmin();
    }

    // GA4 / Play Console / App Store Connect sync collections — written
    // only by the backoffice Cloud Functions via the Admin SDK (which
    // bypasses these rules), read-only from the backoffice dashboard.
    match /ga4_uninstalls/{document} {
      allow read: if isAdmin();
    }

    match /ga4_events_daily/{document} {
      allow read: if isAdmin();
    }

    match /ga4_users_daily/{document} {
      allow read: if isAdmin();
    }

    match /ga4_uninstall_paths_daily/{document} {
      allow read: if isAdmin();
    }

    // Dashboard: ad health (AdMob), versions in use (GA4), and the
    // BigQuery aggregates (ad triggers, retention, new-user funnel).
    match /ad_health_daily/{document} {
      allow read: if isAdmin();
    }

    match /ga4_versions_daily/{document} {
      allow read: if isAdmin();
    }

    match /ga4_ad_triggers_daily/{document} {
      allow read: if isAdmin();
    }

    match /ga4_retention_daily/{document} {
      allow read: if isAdmin();
    }

    match /ga4_funnel_daily/{document} {
      allow read: if isAdmin();
    }

    match /play_console_daily/{document} {
      allow read: if isAdmin();
    }

    match /asc_installs_daily/{document} {
      allow read: if isAdmin();
    }

    match /asc_engagement_daily/{document} {
      allow read: if isAdmin();
    }
    
    match /config/{document} {                                                                                                                                                                                                                              
    	allow read, write: if isAdmin();                                                                                                                                                                                                                             
  	} 

    // --- BLOQUEO FINAL ---
    // Bloquear TODO lo demás (Siempre deja esto al final)
    // One-off link list for the backoffice "Ligas" page and the
    // sendLinkBatch function. Temporary: remove with the module.
    match /link_tasks/{id} { allow read, write: if isAdmin(); }
    match /link_batches/{id} { allow read, write: if isAdmin(); }
    match /link_tasks_config/{id} { allow read, write: if isAdmin(); }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
